# Copy to .env and fill in. Gitignored; never commit the real file.
# ASP.NET maps double underscore to a config section: Jwt__SecretKey -> Jwt:SecretKey.
#
# docker compose reads this file for the `api` service. Running the API directly
# instead, export it first:  set -a; source Splitty-API/.env; set +a; dotnet run

# HMAC-SHA256 signing key for Splitty's own JWTs. Any long random string.
Jwt__SecretKey=

# Google Cloud console -> Credentials -> OAuth client of type "Web application".
# Not the iOS client: an iOS client has no secret and cannot perform the code exchange.
Google__ClientId=
Google__ClientSecret=
