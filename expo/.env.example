# REST API URL. Android emulator uses http://10.0.2.2:8080; iOS simulator uses localhost.
EXPO_PUBLIC_API_BASE_URL=
# Web OAuth client id — MUST be the same client as Google:ClientId on the API.
# Native Google Sign-In requests a server auth code for this client (empty redirect_uri).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client id for bundle com.splitty.app. The reversed client id is the iOS URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android OAuth client id for package com.splitty.app (SHA-1 of the debug/upload keystore).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Development builds show dev login by default. Set false to hide it.
EXPO_PUBLIC_ENABLE_DEV_LOGIN=false
