---
import { localeNames, locales, pathFor, t, type Locale, type Page } from "../i18n";

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
---

<details class="language">
  <summary aria-label={t(locale).nav.language}>
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path
        d="M2.75 10h14.5M10 2.75c2 2.1 3 4.5 3 7.25s-1 5.15-3 7.25c-2-2.1-3-4.5-3-7.25s1-5.15 3-7.25Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"></path>
    </svg>
    <span>{localeNames[locale]}</span>
  </summary>
  <ul>
    {
      locales.map((other) => (
        <li>
          <a
            href={pathFor(other, page)}
            hreflang={other}
            aria-current={other === locale ? "true" : undefined}
          >
            {localeNames[other]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .language {
    position: relative;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    background: var(--card);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    transition:
      color 0.2s ease-out,
      transform 0.2s ease-out;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--text);
  }

  summary:active {
    transform: scale(0.96);
    transition-duration: 0.1s;
  }

  ul {
    position: absolute;
    right: 0;
    bottom: auto;
    top: calc(100% + 0.5rem);
    z-index: 20;
    min-width: 12rem;
    padding: 0.375rem;
    list-style: none;
    border-radius: 1rem;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.6);
    transform-origin: top right;
    animation: pop 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }

  :global(footer) ul {
    top: auto;
    bottom: calc(100% + 0.5rem);
    left: 0;
    right: auto;
    transform-origin: bottom left;
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.625rem;
    text-decoration: none;
    font-size: var(--step--1);
  }

  a:hover {
    background: var(--muted);
  }

  a[aria-current] {
    color: var(--coral);
    font-weight: 600;
  }
</style>
