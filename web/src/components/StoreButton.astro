---
/**
 * TODO: swap for Apple's official "Download on the App Store" badge, linked to the listing,
 * once the app is live. Until then it is a disabled button that goes nowhere.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button class="store" type="button" disabled>
  <svg viewBox="0 0 17 20" width="17" height="20" aria-hidden="true">
    <path
      fill="currentColor"
      d="M14.2 10.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.8-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.8 1.3 10.3.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.9-1.1-2.9-4.3ZM11.7 3.1c.7-.9 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4Z"
    ></path>
  </svg>
  <span>{label}</span>
</button>

<style>
  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    height: 3.25rem;
    padding-inline: 1.375rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--text-muted);
    font: inherit;
    font-size: var(--step-0);
    font-weight: 600;
    cursor: not-allowed;
  }
</style>
