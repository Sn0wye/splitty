---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { htmlLang, locales, pathFor, type Locale, type Page } from "../i18n";

interface Props {
  locale: Locale;
  page: Page;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
const canonical = Astro.site ? new URL(pathFor(locale, page), Astro.site).href : undefined;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      Astro.site &&
        locales.map((other) => (
          <link
            rel="alternate"
            hreflang={htmlLang[other]}
            href={new URL(pathFor(other, page), Astro.site).href}
          />
        ))
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#09090B" />
  </head>
  <body>
    <Header locale={locale} page={page} />
    <slot />
    <Footer locale={locale} page={page} />
  </body>
</html>
